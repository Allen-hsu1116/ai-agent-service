# Do not commit real secrets.
# Current default: online OpenAI-compatible API.
# Local models should also use AI_PROVIDER=openai-compatible when exposed through
# an OpenAI-compatible API server such as vLLM, Ollama, LM Studio, or llama.cpp.
AI_PROVIDER=openai-compatible
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
LLM_TEMPERATURE=0.2

# Local model example: qwen3.5-35b behind a local OpenAI-compatible gateway.
# The app posts to {LLM_BASE_URL}/chat/completions, so do not include /health.
# AI_PROVIDER=openai-compatible
# LLM_BASE_URL=http://localhost:8080/api/v1
# LLM_MODEL=qwen3.5-35b
# LLM_API_KEY=
# LLM_TEMPERATURE=0.2

# Optional aliases / future providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LOCAL_MODEL_PATH=

DATABASE_URL=sqlite:///./data/agent.db
