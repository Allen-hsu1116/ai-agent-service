# Do not commit real secrets.
# Current default: online OpenAI-compatible API.
# Future local model path can use AI_PROVIDER=local or an OpenAI-compatible local endpoint.
AI_PROVIDER=openai-compatible
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
LLM_TEMPERATURE=0.2

# Optional aliases / future providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LOCAL_MODEL_PATH=

DATABASE_URL=sqlite:///./data/agent.db
