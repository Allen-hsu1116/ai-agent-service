# Server deployment example for a local OpenAI-compatible model gateway.
# Copy this file to .env on your server:
#   cp .env.server.example .env

AI_PROVIDER=openai-compatible

# If you run ai-agent-service natively on the same server as the model gateway:
# LLM_BASE_URL=http://localhost:8080/api/v1

# If you run ai-agent-service inside a Docker container and the model gateway runs on the host:
LLM_BASE_URL=http://host.docker.internal:8080/api/v1

# Do not include /health in LLM_BASE_URL. The app calls {LLM_BASE_URL}/chat/completions.
LLM_MODEL=qwen3.5-35b
LLM_API_KEY=
LLM_TEMPERATURE=0.2

# Keep SQLite data in the project data directory. Docker maps ./data to /app/data.
DATABASE_URL=sqlite:///./data/agent.db

# Optional Docker Compose overrides.
SERVICE_HOST_PORT=8020
DATA_DIR=./data
